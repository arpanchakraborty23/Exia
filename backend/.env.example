# ==============================================================================
# Exia FastAPI Backend Environment Configuration
# ==============================================================================

# Authentication (JWT)
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key
JWT_ALGORITHM=HS256

# LiveKit WebRTC Cloud / Self-Hosted
LIVEKIT_API_HOST=wss://your-livekit-subdomain.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxx
LIVEKIT_API_SECRET=sec_yyyyyyyyyyyyyyyyyy

# MongoDB Atlas / Self-Hosted
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=exia_db
MONGODB_USER_COLLECTION=users
MONGODB_SESSION_COLLECTION=sessions
MONGODB_MCP_COLLECTION=mcp_servers
MONGODB_PROMPT_COLLECTION=prompts
MONGODB_MODEL_COLLECTION=model_config
MONGODB_BLACKLIST_COLLECTION=token_blacklist

# AI Providers (Optional: Can also be passed dynamically from UI)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxx
SPEECHMATICS_API_KEY=sm_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxx
CARTESIA_API_KEY=car_xxxxxxxxxxxxxxxxxxxxxxxxx
DEEPGRAM_API_KEY=dg_xxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
