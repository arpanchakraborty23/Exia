{
  "name": "exia-ui",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mobile:start": "pnpm --dir apps/mobile start",
    "mobile:android": "pnpm --dir apps/mobile android",
    "mobile:lint": "pnpm --dir apps/mobile lint",
    "web:start": "pnpm --dir apps/mobile web",
    "web:build": "pnpm --dir apps/mobile exec expo export --platform web",
    "desktop:build": "pnpm web:build && node ../desktop/scripts/sync-dist.js",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
