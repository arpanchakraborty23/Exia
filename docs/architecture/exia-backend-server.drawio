        <mxCell id="f3" value="2 · writes / reads UI data (PyMongo)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bc" target="mongo">
          <mxGeometry relative="1" as="geometry" />
