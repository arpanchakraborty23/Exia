        <mxCell id="mongo" value="MongoDB Atlas (cloud database)" style="shape=mxgraph.aws4.group_aws_cloud;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1">
