        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;› teal — realtime WebRTC (no persistence)&lt;br&gt;› green — user data written by Backend (only path to DB)&lt;br&gt;› purple — Agent reads user data from DB&lt;br&gt;› AWS (mxgraph.aws4) resource icons — Eraser-style cloud diagrams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
