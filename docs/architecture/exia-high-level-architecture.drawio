          <mxGeometry x="20" y="52" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lkText" value="WebRTC SFU — localhost:7880 or LiveKit Cloud&lt;br&gt;Opus 48kHz realtime audio / video&lt;br&gt;Routes media only — stores nothing" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="livekit">
          <mxGeometry x="66" y="52" width="300" height="95" as="geometry" />
