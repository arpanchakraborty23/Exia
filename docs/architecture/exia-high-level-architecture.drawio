        <mxCell id="agText" value="&lt;b&gt;Python · livekit-agents&lt;/b&gt;&lt;br&gt;• Silero VAD · STT · LLM · TTS  • Mem0&lt;br&gt;• MCP tool engine  • Camera / screen inspection&lt;br&gt;&lt;i&gt;No direct UI connection — no own storage&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="agent">
          <mxGeometry x="12" y="62" width="356" height="120" as="geometry" />
