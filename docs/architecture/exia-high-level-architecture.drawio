        </mxCell>
        <mxCell id="uiText" value="&lt;b&gt;Next.js 15 · React 19 (Web / Desktop)&lt;/b&gt;&lt;br&gt;• Voice Session Stage  • Session History&lt;br&gt;• MCP Hub  • Prompt Directives  • Model Config&lt;br&gt;• Login / Auth (JWT stored client-side)&lt;br&gt;&lt;i&gt;Stores nothing local — sends ALL user data to the Backend&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="ui">
          <mxGeometry x="12" y="62" width="356" height="110" as="geometry" />
        </mxCell>
        <mxCell id="backend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
