<mxfile host="app.diagrams.net" agent="Exia" version="24.7.17" type="device">
  <diagram id="exia-high-level" name="Exia — High-Level Architecture">
    <mxGraphModel dx="1422" dy="757" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="Exia — Private Home AI Assistant · High-Level Architecture" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="10" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;Exia UI&lt;/b&gt; — Next.js 15 · React 19 (Web / Desktop)&lt;br&gt;&lt;br&gt;• Voice Session Stage  • Session History&lt;br&gt;• MCP Hub  • Prompt Directives  • Model Config&lt;br&gt;• Login / Auth (JWT stored client-side)&lt;br&gt;&lt;br&gt;&lt;i&gt;Stores nothing local — sends ALL user data to the Backend&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="380" height="180" as="geometry" />
        </mxCell>
        <mxCell id="backend" value="&lt;b&gt;Backend&lt;/b&gt; — FastAPI Gateway · :8000&lt;br&gt;&lt;br&gt;• Auth  • LiveKit Token service  • MCP registry&lt;br&gt;• Prompts  • Model config  • Sessions history&lt;br&gt;• Static SPA file server&lt;br&gt;&lt;br&gt;&lt;i&gt;The ONLY writer of ALL UI data to the DB&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="livekit" value="&lt;b&gt;LiveKit Server&lt;/b&gt; — WebRTC SFU&lt;br&gt;localhost:7880 or LiveKit Cloud&lt;br&gt;&lt;br&gt;• Opus 48kHz realtime audio / video transport&lt;br&gt;&lt;i&gt;Routes media only — stores nothing&lt;/i&gt;" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="380" height="170" as="geometry" />
        </mxCell>
        <mxCell id="mongo" value="&lt;b&gt;MongoDB Atlas&lt;/b&gt; (cloud database) · home_assistant&lt;br&gt;&lt;br&gt;• users  • sessions  • mcp_servers&lt;br&gt;• prompts  • model_config  • token_blacklist&lt;br&gt;&lt;br&gt;&lt;i&gt;Single source of truth for every component&lt;/i&gt;" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="470" width="420" height="300" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;Voice Agent Worker&lt;/b&gt; — Python · livekit-agents&lt;br&gt;&lt;br&gt;• Silero VAD · STT · LLM · TTS  • Mem0 memory&lt;br&gt;• MCP tool engine  • Camera / screen inspection&lt;br&gt;&lt;br&gt;&lt;i&gt;No direct UI connection — no own storage&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="380" height="210" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Design rule&lt;/b&gt;&lt;br&gt;• UI never talks to the DB directly&lt;br&gt;• Agent never receives UI data and stores nothing&lt;br&gt;• MongoDB is the only bridge: Backend writes, Agent reads user data" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff9cc;strokeColor=#d6b656;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="810" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;› teal — realtime WebRTC (no persistence)&lt;br&gt;› green — user data written by Backend (only path to DB)&lt;br&gt;› purple — Agent reads user data from DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="830" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="1 · HTTPS REST /api/* (JWT bearer)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ui" target="backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2 · persists ALL UI data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="backend" target="mongo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="3 · WebRTC Opus audio / video" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0e8088;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ui" target="livekit">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="174" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="4 · room session — user A/V in · assistant audio out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0e8088;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="livekit" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="5 · reads user data only (MCP servers · prompts · memories) + session events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="agent" target="mongo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
