          <mxGeometry x="62" y="15" width="250" height="24" as="geometry" />
        </mxCell>
        <mxCell id="beText" value="&lt;b&gt;FastAPI Gateway · :8000&lt;/b&gt;&lt;br&gt;• Auth  • LiveKit Token service  • MCP registry&lt;br&gt;• Prompts  • Model config  • Sessions history&lt;br&gt;• Static SPA file server&lt;br&gt;&lt;i&gt;The ONLY writer of ALL UI data to the DB&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="backend">
          <mxGeometry x="12" y="62" width="376" height="130" as="geometry" />
        </mxCell>
        <mxCell id="livekit" value="LiveKit Server / LiveKit Cloud" style="shape=mxgraph.aws4.group_aws_cloud;html=1;whiteSpace=wrap;fillColor=#b0e3e6;strokeColor=#0e8088;verticalAlign=top;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1">
