        <mxCell id="dbIcon" value="" style="shape=mxgraph.aws4.database;html=1;fillColor=#C7131F;strokeColor=none;aspect=fixed;" vertex="1" parent="mongo">
          <mxGeometry x="22" y="42" width="38" height="38" as="geometry" />
        </mxCell>
        <mxCell id="dbText" value="db: home_assistant&lt;br&gt;• users · sessions · mcp_servers&lt;br&gt;• prompts · model_config · token_blacklist&lt;br&gt;&lt;br&gt;&lt;i&gt;Single source of truth — the ONLY bridge between the UI and the Agent&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="mongo">
          <mxGeometry x="70" y="45" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="&lt;b&gt;Design rule&lt;/b&gt;&lt;br&gt;• UI never talks to the DB directly&lt;br&gt;• Agent never receives UI data and stores nothing&lt;br&gt;• MongoDB is the only bridge: Backend writes, Agent reads user data" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff9cc;strokeColor=#d6b656;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="810" width="420" height="140" as="geometry" />
        </mxCell>
