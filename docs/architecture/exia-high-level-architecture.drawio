        <mxCell id="t1" value="Exia — Private Home AI Assistant · High-Level Architecture (AWS-style cloud icons)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
