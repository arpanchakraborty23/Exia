# ==============================================================================
# Exia Unified Workspace Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FastAPI Backend & Database
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_signing_key_exia_2026
JWT_ALGORITHM=HS256

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=exia_db
MONGODB_USER_COLLECTION=users
MONGODB_SESSION_COLLECTION=sessions
MONGODB_MCP_COLLECTION=mcp_servers
MONGODB_PROMPT_COLLECTION=prompts
MONGODB_MODEL_COLLECTION=model_config
MONGODB_BLACKLIST_COLLECTION=token_blacklist

# ------------------------------------------------------------------------------
# 2. LiveKit Cloud / SFU Server
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-subdomain.livekit.cloud
LIVEKIT_API_HOST=wss://your-livekit-subdomain.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ------------------------------------------------------------------------------
# 3. Frontend Next.js Client
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-subdomain.livekit.cloud
CORS_ORIGINS=https://arpanchakraborty23.github.io,http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://localhost:5179,http://localhost:5180,http://localhost:5181,http://localhost:5182,http://localhost:5183,http://localhost:5184,http://localhost:5185,http://localhost:5186,http://localhost:5187,http://localhost:5188,http://localhost:5189,http://localhost:5190
