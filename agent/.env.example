# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=home_assistant

# Mem0 Memory Connection String / API Key
# If using Mem0 Platform or Mem0 MCP: pass your 'm0-...' API key string here
# If using Mem0 with MongoDB: it will automatically use MONGODB_URI
MEM0_API_KEY=m0-your-mem0-api-key-here

# LiveKit Server Connection
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# LLM Endpoint (Local Ollama, LM Studio, or OpenAI)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
